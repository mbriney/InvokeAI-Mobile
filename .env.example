# Copy to .env for local use. In GitHub: Settings → Secrets and variables → Actions.
#   Variables:  INVOKE_URL, APP_TITLE, DEFAULT_MODEL, MAX_SIZE
#   Secrets:    APP_PIN   (keeps the code out of the public build log)

# Required — your InvokeAI instance (no trailing slash)
INVOKE_URL=https://imagine.briney.me

# Optional — 4-digit lock code for the app. Leave empty to disable.
APP_PIN=

# Optional
APP_TITLE=Imagine
# Name (or part of a name) of the model to pre-select, e.g. "Juggernaut"
DEFAULT_MODEL=
# Longest edge of the image sent to the model (1024 is right for SDXL/FLUX)
MAX_SIZE=1024
